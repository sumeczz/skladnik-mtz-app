{
  "_comment": "Generov\u00e1no tools/gs1_reference.py. Neupravuj ru\u010dn\u011b.",
  "check_digit": [
    {
      "payload": "400638133393",
      "expected": "1",
      "note": "EAN-13 4006381333931 (ve\u0159ejn\u011b zn\u00e1m\u00fd p\u0159\u00edklad)"
    },
    {
      "payload": "590123412345",
      "expected": "7",
      "note": "EAN-13 5901234123457 (ve\u0159ejn\u011b zn\u00e1m\u00fd p\u0159\u00edklad)"
    },
    {
      "payload": "950110153000",
      "expected": "3",
      "note": "GTIN-13 9501101530003 (vzorov\u00fd GS1 p\u0159\u00edklad)"
    },
    {
      "payload": "0950110153000",
      "expected": "3",
      "note": "GTIN-14 s \u00favodn\u00ed nulou: 09501101530003"
    },
    {
      "payload": "10614141234567890",
      "expected": "8",
      "note": "SSCC payload (17 \u010d\u00edslic)"
    },
    {
      "payload": "00000000000000000",
      "expected": "0",
      "note": "sam\u00e9 nuly"
    }
  ],
  "sscc_build": [
    {
      "extension": 1,
      "company_prefix": "0614141",
      "serial": 234567890,
      "expected": "106141412345678908",
      "note": "prefix 7 \u010d\u00edslic, serial 9 \u010d\u00edslic"
    },
    {
      "extension": 0,
      "company_prefix": "8591234",
      "serial": 1,
      "expected": "085912340000000017",
      "note": "FIKTIVN\u00cd prefix, serial 1"
    },
    {
      "extension": 3,
      "company_prefix": "85912345678",
      "serial": 1,
      "expected": "385912345678000018",
      "note": "prefix 11 \u010d\u00edslic, serial 5 \u010d\u00edslic"
    },
    {
      "extension": 9,
      "company_prefix": "859123456",
      "serial": 9999999,
      "expected": "985912345699999997",
      "note": "prefix 9 \u010d\u00edslic, serial 7 \u010d\u00edslic"
    }
  ],
  "sscc_build_errors": [
