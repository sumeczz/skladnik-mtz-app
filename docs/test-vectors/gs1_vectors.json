      "extension": 1,
      "company_prefix": "0614141",
      "serial": 1000000000,
      "expected_error": "SERIAL_OVERFLOW"
    },
    {
      "extension": 10,
      "company_prefix": "0614141",
      "serial": 1,
      "expected_error": "BAD_EXTENSION"
    },
    {
      "extension": 1,
      "company_prefix": "12345",
      "serial": 1,
      "expected_error": "BAD_PREFIX"
    }
